# indie:lang_version = 5
from indie import indicator, MainContext, sec_context, TimeFrame, plot

@sec_context
def Secondary(self):
    return self.close[0], self.volume[0], self.time[0]

@indicator('TP Probe 4A - Same Instrument Control')
@plot.line(title='Secondary close')
@plot.line(title='Secondary volume')
@plot.line(title='Secondary bar time')
class Main(MainContext):
    def __init__(self):
        self._c, self._v, self._t = self.calc_on(
            Secondary, time_frame=TimeFrame.from_str('1m'),
        )

    def calc(self):
        return self._c[0], self._v[0], self._t[0]
