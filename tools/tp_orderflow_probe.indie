# indie:lang_version = 5
from math import nan
from indie import indicator, MainContext, TimeFrame, Series, request_series, plot, color
from indie.data import VolumeFootprintProfile, sources

@indicator('TP Probe 2 - Order Flow')
@plot.line(title='Buy volume', color=color.GREEN)
@plot.line(title='Sell volume', color=color.RED)
@plot.columns(title='Volume delta')
@plot.line(title='Total volume')
@plot.line(title='Buy trade count')
@plot.line(title='Sell trade count')
@plot.line(title='Buy share percent')
@plot.line(title='Volume POC price')
@plot.line(title='Row size')
@plot.line(title='Row count')
@plot.line(title='Profile start')
@plot.line(title='Profile end')
class Main(MainContext):
    def __init__(self):
        self._fp: Series[VolumeFootprintProfile] = request_series[VolumeFootprintProfile](
            source=sources.VolumeFootprint(row_size_ticks=0),
            time_frame=TimeFrame.from_str('1m'),
        )

    def calc(self):
        p = self._fp[0]
        buy = p.total_volume_buy
        sell = p.total_volume_sell
        total = buy + sell
        share = nan
        poc = nan
        max_vol = -1.0
        if total > 0.0:
            share = 100.0 * buy / total
        for row in p.rows:
            v = row.volume_buy + row.volume_sell
            if v > max_vol and v > 0.0:
                max_vol = v
                poc = row.price
        delta = buy - sell
        col = color.GREEN if delta >= 0.0 else color.RED
        return buy, sell, plot.Columns(delta, color=col), total, float(p.total_trades_count_buy), float(p.total_trades_count_sell), share, poc, p.row_size, float(len(p.rows)), float(p.profile_start_unix_seconds), float(p.profile_end_unix_seconds)
