# indie:lang_version = 5
from indie import indicator, MainContext, TimeFrame, Series, request_series, plot, color
from indie.data import TpoProfile, sources

@indicator('TP Probe 3 - Market Profile', overlay_main_pane=True)
@plot.line(title='TPO POC', color=color.BLUE)
@plot.line(title='Initial balance high', color=color.GREEN)
@plot.line(title='Initial balance low', color=color.RED)
class Main(MainContext):
    def __init__(self):
        self._tpo: Series[TpoProfile] = request_series[TpoProfile](
            source=sources.Tpo(),
            time_frame=TimeFrame.from_str('1D'),
        )

    def calc(self):
        p = self._tpo[0]
        return p.point_of_control, p.initial_balance_high, p.initial_balance_low
