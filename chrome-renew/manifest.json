{
  "manifest_version": 3,
  "name": "tpscraper renewal",
  "version": "1.1.0",
  "description": "Local authorization for tpscraper using your signed-in TakeProfit session.",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://takeprofit.com/*",
    "http://127.0.0.1:8790/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}